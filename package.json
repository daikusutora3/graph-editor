{
  "name": "graph-editor",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first browser app for creating, editing, arranging, and exporting graph theory diagrams.",
  "license": "MIT",
  "homepage": "https://graph-editor.daikusutora3.workers.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daikusutora3/graph-editor.git"
  },
  "bugs": {
    "url": "https://github.com/daikusutora3/graph-editor/issues"
  },
  "keywords": [
    "graph-theory",
    "graph-editor",
    "graph-visualization",
    "cytoscape",
    "nextjs"
  ],
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": "24.15.0",
    "bun": "1.4.2"
  },
  "scripts": {
    "toolchain:check": "node scripts/toolchain.mjs --check",
    "preinstall": "node scripts/toolchain.mjs --check",
    "predev": "node scripts/toolchain.mjs --check",
    "prebuild": "node scripts/toolchain.mjs --check",
    "precheck": "node scripts/toolchain.mjs --check",
    "precheck:all": "node scripts/toolchain.mjs --check",
    "dev": "next dev",
    "build": "bun run check:wasm && next build && bun run scripts/build-headers.ts",
    "build:wasm": "bun run scripts/build-wasm.ts",
    "check:wasm": "bun run scripts/build-wasm.ts --check",
    "benchmark:edge-routing": "bun run tests/benchmarks/edge-routing.ts",
    "benchmark:routing": "bun run tests/benchmarks/routing-performance.ts",
    "benchmark:layouts": "bun run tests/benchmarks/layout-performance.ts",
    "benchmark:wasm": "bun run tests/benchmarks/wasm-layouts.ts && bun run tests/benchmarks/wasm-routing.ts && bun run tests/benchmarks/wasm-routing-collisions.ts && bun run tests/benchmarks/wasm-interactive-routing.ts && bun run tests/benchmarks/wasm-projected-obstacles.ts",
    "benchmark:wasm-routing-optimizations": "bun run tests/benchmarks/wasm-routing-optimizations.ts",
    "benchmark:wasm-routing-distances": "bun run tests/benchmarks/wasm-routing-distances.ts",
    "benchmark:loop-preparation": "bun run tests/benchmarks/loop-preparation.ts",
    "benchmark:wasm-loop-obstacles": "bun run tests/benchmarks/wasm-loop-obstacles.ts",
    "benchmark:wasm-import": "bun run tests/benchmarks/wasm-import.ts",
    "benchmark:bundle": "bun run tests/benchmarks/initial-bundle.ts",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "policy:check": "/usr/bin/python3 .codex/hooks/block_github_issues.py --self-test",
    "privacy:check": "bun run scripts/privacy-check.ts --staged",
    "privacy:check:unpushed": "bun run scripts/privacy-check.ts --range origin/main..HEAD",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc -p tsconfig.strict.json --noEmit",
    "audit:ui": "bun scripts/audit/ui-audit.mjs",
    "audit:csp": "bun scripts/audit/csp-check.mjs",
    "serve:out": "bun scripts/audit/serve-out.mjs",
    "test": "bun run tests/verification/run-all.ts",
    "test:rust": "bun run scripts/test-rust.ts",
    "prepare": "git config core.hooksPath .githooks",
    "check": "tsc --noEmit && tsc -p tsconfig.strict.json --noEmit && oxlint . --deny-warnings && prettier . --check && bun run policy:check && bun run test",
    "check:all": "bun run check && bun run test:rust && bun run build && bun run tests/verification/release.ts"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "cytoscape": "3.34.3",
    "jotai": "3.0.1",
    "lucide-react": "1.55.0",
    "nanoid": "6.0.2",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxlint": "1.87.0",
    "playwright": "1.64.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
